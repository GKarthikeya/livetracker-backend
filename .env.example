# Copy this file to .env and fill in values
PORT=3001
WS_PORT=3002

# 1xbet account credentials (use a demo account)
ONEX_USERNAME=your_demo_username
ONEX_PASSWORD=your_demo_password

# Scrape interval in milliseconds (default: 15000 = 15 seconds)
SCRAPE_INTERVAL_MS=3000

# Max ratio history points per event
MAX_HISTORY_POINTS=200
